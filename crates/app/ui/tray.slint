// The tray icon and its menu: a new version when there is one, every account with its fuel, the
// automatic switch, Start with Windows, Settings, the GitHub page and Quit.

export enum TrayFuel { reading, unavailable, ready, empty }

// `claude` and `gemini`: what is left of each group, the tighter of its 5-hour and weekly limits.
export struct TrayAccount {
    name: string,
    active: bool,
    fuel: TrayFuel,
    claude: string,
    gemini: string,
}

export component Tray inherits SystemTrayIcon {
    in property <[TrayAccount]> accounts;
    in property <string> active-name;
    in property <string> active-claude;
    in property <string> active-gemini;
    in-out property <bool> auto-switch;
    in-out property <bool> start-with-windows;
    in property <string> update-version;
    callback open();
    callback update();
    callback open-project();
    callback pick(string);
    callback auto-switch-toggled(bool);
    callback start-with-windows-toggled(bool);
    callback open-settings();
    callback quit();

    icon: @image-url("../assets/tray-32.png");
    tooltip: root.active-name == "" ? @tr("Antigravity Account Switcher")
        : root.active-claude == "" ? @tr("Antigravity Account Switcher · {}", root.active-name)
        : @tr("Antigravity Account Switcher · {} · Claude and GPT {} · Gemini {}", root.active-name, root.active-claude, root.active-gemini);
    clicked => { root.open(); }

    Menu {
        MenuItem {
            title: @tr("Open Antigravity Account Switcher");
            activated => { root.open(); }
        }
        if root.update-version != "": MenuItem {
            title: @tr("Update to {}", root.update-version);
            activated => { root.update(); }
        }
        MenuSeparator { }
        for account in root.accounts: MenuItem {
            title: (account.active ? "●  " : "     ") + (
                account.fuel == TrayFuel.reading ? @tr("{} — reading quota…", account.name)
                : account.fuel == TrayFuel.unavailable ? @tr("{} — quota unavailable", account.name)
                : account.fuel == TrayFuel.empty ? @tr("{} — out of quota (Claude and GPT {} · Gemini {})", account.name, account.claude, account.gemini)
                : @tr("{} — Claude and GPT {} · Gemini {}", account.name, account.claude, account.gemini));
            activated => { root.pick(account.name); }
        }
        if root.accounts.length == 0: MenuItem {
            title: @tr("No saved accounts yet");
            enabled: false;
        }
        MenuSeparator { }
        MenuItem {
            title: @tr("Switch automatically when quota runs out");
            checkable: true;
            checked <=> root.auto-switch;
            activated => { root.auto-switch-toggled(self.checked); }
        }
        MenuItem {
            title: @tr("Start with Windows");
            checkable: true;
            checked <=> root.start-with-windows;
            activated => { root.start-with-windows-toggled(self.checked); }
        }
        MenuItem {
            title: @tr("Settings…");
            activated => { root.open-settings(); }
        }
        MenuItem {
            title: @tr("GitHub page");
            activated => { root.open-project(); }
        }
        MenuSeparator { }
        MenuItem {
            title: @tr("Quit");
            activated => { root.quit(); }
        }
    }
}
