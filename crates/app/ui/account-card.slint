// One saved account: the orbit gauge, who it is, its four limits, and what you can do with it.
//
// Each piece of the card has a fixed width or elides, and the grid never makes a card narrower
// than CardMetrics.min-width, the width its fixed pieces need: nothing is ever pushed out of it.

import { Theme } from "theme.slint";
import { Icons, Icon } from "icons.slint";
import { ActionButton, ButtonKind, IconButton, Tag } from "controls.slint";
import { OrbitGauge } from "orbit-gauge.slint";
import { Copy } from "copy.slint";
import { DisplayLabel, BodyLabel } from "text.slint";

export enum CardState { loading, ready, failed }

export struct Gauge {
    present: bool,
    fraction: float,
    percent: string,
    resets: string,
    low: bool,
}

export struct AccountView {
    name: string,
    initial: string,
    email: string,
    plan: string,
    active: bool,
    state: CardState,
    problem-code: string,
    problem-detail: string,
    claude-five-hour: Gauge,
    claude-weekly: Gauge,
    gemini-five-hour: Gauge,
    gemini-weekly: Gauge,
}

export global CardMetrics {
    // The narrowest card whose content fits: padding 2 × 20, the gauge 124, the gap 20, and the
    // limits table 224 (a group name of up to 80, two value columns of 60, gaps of 12). Two cards
    // of it and the gap between them fill the narrowest window.
    out property <length> min-width: 408px;
    out property <length> height: 262px;
    // From this width the action button has room for its full label.
    out property <length> full-labels: 520px;
}

// One limit in the table: a dot in its orbit's colour, the percent, and under it the time until
// it refills (empty while the limit is full).
component Limit inherits VerticalLayout {
    in property <Gauge> gauge;
    in property <color> tint;

    width: 60px;
    HorizontalLayout {
        height: 20px;
        alignment: end;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.gauge.present ? root.tint : Theme.edge-bright;
            }
        }
        DisplayLabel {
            text: root.gauge.present ? root.gauge.percent : "—";
            color: !root.gauge.present ? Theme.dust-dim : root.gauge.low ? Theme.flare : Theme.starlight;
        }
    }
    DisplayLabel {
        height: 14px;
        text: root.gauge.resets;
        color: Theme.dust;
        font-size: Theme.text-xs;
        font-weight: 400;
        horizontal-alignment: right;
    }
}

component ColumnHead inherits DisplayLabel {
    height: 14px;
    color: Theme.dust-dim;
    font-size: Theme.text-xs;
    letter-spacing: 1.2px;
    horizontal-alignment: right;
}

// A group's name, on the line of its percents.
component GroupName inherits VerticalLayout {
    in property <string> text;
    alignment: start;
    horizontal-stretch: 1;
    BodyLabel {
        height: 20px;
        text: root.text;
        color: Theme.dust;
        overflow: elide;
    }
}

export component AccountCard inherits Rectangle {
    in property <AccountView> account;
    callback launch();
    callback details();
    callback shortcut();
    callback remove();

    property <bool> hot: hover.has-hover;
    property <bool> narrow: root.width < CardMetrics.full-labels;

    border-radius: Theme.radius-lg;
    background: root.hot ? Theme.hull-raised : Theme.hull;
    border-width: 1px;
    border-color: root.account.active ? Theme.aurora.with-alpha(0.55)
        : root.hot ? Theme.edge-bright : Theme.edge;
    drop-shadow-blur: root.account.active ? 28px : root.hot ? 22px : 0;
    drop-shadow-offset-y: root.hot ? 8px : 0;
    drop-shadow-color: root.account.active ? Theme.aurora.with-alpha(0.16) : #00000066;
    animate background, border-color, drop-shadow-blur, drop-shadow-offset-y { duration: Theme.calm; easing: ease-out; }

    hover := TouchArea {
        double-clicked => { root.launch(); }
    }

    VerticalLayout {
        padding: 20px;
        padding-bottom: 16px;
        spacing: 16px;

        HorizontalLayout {
            spacing: 20px;
            vertical-stretch: 1;

            VerticalLayout {
                alignment: center;
                OrbitGauge {
                    claude-weekly: root.account.claude-weekly.fraction;
                    has-claude-weekly: root.account.claude-weekly.present;
                    claude-five-hour: root.account.claude-five-hour.fraction;
                    has-claude-five-hour: root.account.claude-five-hour.present;
                    gemini-weekly: root.account.gemini-weekly.fraction;
                    has-gemini-weekly: root.account.gemini-weekly.present;
                    gemini-five-hour: root.account.gemini-five-hour.fraction;
                    has-gemini-five-hour: root.account.gemini-five-hour.present;
                    initial: root.account.initial;
                    active: root.account.active;
                    failed: root.account.state == CardState.failed;
                }
            }

            VerticalLayout {
                alignment: start;
                horizontal-stretch: 1;

                HorizontalLayout {
                    height: 26px;
                    spacing: 10px;
                    DisplayLabel {
                        text: root.account.name;
                        font-size: Theme.text-lg;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    if root.account.active: VerticalLayout {
                        alignment: center;
                        Tag { text: @tr("ACTIVE"); tint: Theme.aurora; pulse: true; }
                    }
                }
                BodyLabel {
                    height: 18px;
                    text: root.account.email == "" ? @tr("Email not known yet") : root.account.email;
                    color: Theme.dust;
                    overflow: elide;
                }
                Rectangle { height: 14px; }

                if root.account.state == CardState.ready: GridLayout {
                    spacing-horizontal: 12px;
                    spacing-vertical: 6px;
                    Row {
                        Rectangle { horizontal-stretch: 1; }
                        ColumnHead { text: @tr("5-HOUR"); }
                        ColumnHead { text: @tr("WEEKLY"); }
                    }
                    Row {
                        GroupName { text: @tr("Claude & GPT"); }
                        Limit { gauge: root.account.claude-five-hour; tint: Theme.solar; }
                        Limit { gauge: root.account.claude-weekly; tint: Theme.ion; }
                    }
                    Row {
                        GroupName { text: @tr("Gemini"); }
                        Limit { gauge: root.account.gemini-five-hour; tint: Theme.pulsar; }
                        Limit { gauge: root.account.gemini-weekly; tint: Theme.nebula; }
                    }
                }
                if root.account.state == CardState.loading: BodyLabel {
                    text: @tr("Reading quota…");
                    color: Theme.dust;
                }
                if root.account.state == CardState.failed: HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: start;
                        // Centres the icon on the first line's capitals.
                        padding-top: 1.5px;
                        Icon { source: Icons.warning; tint: Theme.flare; size: 16px; }
                    }
                    Text {
                        text: Copy.problem(root.account.problem-code, root.account.problem-detail);
                        color: Theme.flare;
                        font-size: Theme.text-sm;
                        wrap: word-wrap;
                        max-lines: 4;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.edge;
        }

        HorizontalLayout {
            spacing: 4px;

            ActionButton {
                label: root.account.active ? @tr("Open Antigravity") : @tr("Switch to this account");
                text: !root.narrow ? self.label : root.account.active ? @tr("Open") : @tr("Switch");
                icon: root.account.active ? Icons.external : Icons.switch;
                kind: root.account.active ? ButtonKind.quiet : ButtonKind.accent;
                lit: root.hot;
                clicked => { root.launch(); }
            }
            Rectangle { horizontal-stretch: 1; }
            if root.account.plan != "": VerticalLayout {
                alignment: center;
                Tag { text: root.account.plan; tint: Theme.nebula; }
            }
            Rectangle { width: 6px; }
            IconButton { icon: Icons.gauge; label: @tr("Quota details"); clicked => { root.details(); } }
            IconButton { icon: Icons.shortcut; label: @tr("Create desktop shortcut"); clicked => { root.shortcut(); } }
            IconButton {
                icon: Icons.trash;
                label: @tr("Remove account");
                hot-tint: Theme.flare;
                hot-fill: Theme.flare.with-alpha(0.12);
                clicked => { root.remove(); }
            }
        }
    }
}
