// Line icons: SVG files in icons/ drawn on a 24×24 grid with a 2-unit stroke (1.5 for the
// window buttons), round caps and joins, in white. Slint renders an SVG at the size it is shown,
// so they stay sharp at every screen scale, and `colorize` gives them any color.

import { Theme } from "theme.slint";

export global Icons {
    out property <image> plus: @image-url("icons/plus.svg");
    out property <image> minus: @image-url("icons/minus.svg");
    out property <image> refresh: @image-url("icons/refresh.svg");
    out property <image> more: @image-url("icons/more.svg");
    out property <image> close: @image-url("icons/close.svg");
    out property <image> check: @image-url("icons/check.svg");
    // Switch to an account.
    out property <image> switch: @image-url("icons/switch.svg");
    // Open in another program: Antigravity, a web page.
    out property <image> external: @image-url("icons/external.svg");
    // Quota details.
    out property <image> gauge: @image-url("icons/gauge.svg");
    // A desktop shortcut.
    out property <image> shortcut: @image-url("icons/shortcut.svg");
    out property <image> trash: @image-url("icons/trash.svg");
    // Install and update.
    out property <image> download: @image-url("icons/download.svg");
    // Settings.
    out property <image> sliders: @image-url("icons/sliders.svg");
    // Quit.
    out property <image> power: @image-url("icons/power.svg");
    out property <image> warning: @image-url("icons/warning.svg");
    out property <image> info: @image-url("icons/info.svg");
    out property <image> help: @image-url("icons/help.svg");
    out property <image> minimize: @image-url("icons/minimize.svg");
    out property <image> maximize: @image-url("icons/maximize.svg");
    out property <image> restore: @image-url("icons/restore.svg");
}

export component Icon inherits Image {
    in property <brush> tint: Theme.starlight;
    in property <length> size: 18px;

    width: root.size;
    height: root.size;
    image-fit: contain;
    colorize: root.tint;
    accessible-role: none;
}
