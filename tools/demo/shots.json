        {"wait": 700},
        {"shot": "21-remove", "around": [{"id": "Sheet::panel"}], "pad": 36},
        {"click": "Keep it"},
        {"wait": 400},
        {"scroll": {"type": "AccountCard", "nth": 0}, "by": 600},
        {"wait": 400},
        {"click": "Add account"},
        {"wait": 500},
        {"type": "freelance"},
        {"wait": 500},
        {"shot": "05-add-name", "around": [{"id": "Sheet::panel"}], "pad": 10},
