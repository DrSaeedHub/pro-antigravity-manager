        {"wait": 2600},
        {"shot": "08-add-signed-in", "around": [{"id": "Sheet::panel"}], "pad": 10},
        {"click": "Save account"},
        {"wait": 900},
        {"shot": "09-add-saved", "around": [{"id": "AppWindow::toast-card"}], "pad": 4},
        {"wait": "quota"},
        {"wait": 4500},
        {"click": "Switch to this account", "nth": 0},
        {"wait": 700},
        {"shot": "10-switch-confirm", "around": [{"id": "Sheet::panel"}], "pad": 36},
        {"click": "Close and switch"},
        {"wait": 1200},
        {"shot": "11-switched", "around": [{"id": "AppWindow::toast-card"}], "pad": 4},
        {"wait": 4500},
        {"click": "Close", "nth": 0},
        {"wait": 900},
        {"shot": "15-tray-notice", "in": "notice"}
      ]
    },
